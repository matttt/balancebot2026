  static uint32_t last_tick = 0;
  static uint32_t oscillation_start_us = micros();
  const uint32_t period_us = 2000;

  if (micros() - last_tick >= period_us) {

    last_tick += period_us;

    float elapsed_s = (micros() - oscillation_start_us) * 1.0e-6f;
    float torque = OSCILLATION_TORQUE_AMPLITUDE *
                   sinf(TWO_PI * elapsed_s / OSCILLATION_PERIOD_S);
    float left  = torque;
    float right = torque;

#if 0
